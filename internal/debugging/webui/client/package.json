{
  "name": "ultima5redux-debug-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "test": "node --test typecheck_checks.mjs && vitest run",
    "test:browser": "vite build --outDir browser/.build && node --max-old-space-size=96 --max-semi-space-size=2 node_modules/@playwright/test/cli.js test",
    "typecheck": "node typecheck.mjs"
  },
  "dependencies": {
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "jsdom": "^27.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.1"
  }
}
