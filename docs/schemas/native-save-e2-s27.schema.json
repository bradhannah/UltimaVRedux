{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bradhannah/UltimaVRedux/main/docs/schemas/native-save-e2-s27.schema.json",
  "title": "Native Ultima V Redux Save Envelope 2 / Snapshot 27",
  "description": "Load frozen sibling s16-s26 schemas locally and assert the version-aware ultima5-world-journal format. V27 adds the record of quest deeds already paid experience, as ascending unique keys, and the points an even kill-experience split has carried forward. Older saves promote with no paid deeds and a zero remainder.",
  "type": "object", "additionalProperties": false,
  "required": ["format", "envelopeVersion", "metadata", "snapshot"],
  "properties": {
    "format": {"const": "ultima5redux-native-snapshot"}, "envelopeVersion": {"const": 2},
    "metadata": {"$ref": "native-save-e2-s26.schema.json#/properties/metadata"},
    "snapshot": {"$ref": "#/$defs/snapshot"}
  },
  "$defs": {
    "snapshot": {
      "type": "object", "additionalProperties": false, "format": "ultima5-world-journal",
      "required": ["version", "party", "inventory", "world", "progression", "effects", "wind", "random", "continuation", "redux", "presentation", "lastConversation", "excerpts", "notes", "dungeonJournal", "moonstoneJournal", "atlasLandmarks", "dungeon", "partyVehicle", "mapUnits", "itemStacks", "mapMutations", "openDoor", "basementChestHistory", "atlasNotes", "atlasFleet", "codexRevelationComplete", "deedExperiencePaid", "sharedExperienceRemainder"],
      "properties": {
        "version": {"const": 27},
        "party": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/party"},
        "inventory": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/inventory"},
        "world": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/world"},
        "progression": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/progression"},
        "effects": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/effects"},
        "wind": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/wind"},
        "random": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/random"},
        "continuation": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/continuation"},
        "redux": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/redux"},
        "presentation": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/presentation"},
        "lastConversation": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/lastConversation"},
        "excerpts": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/excerpts"},
        "notes": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/notes"},
        "dungeonJournal": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/dungeonJournal"},
        "moonstoneJournal": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/moonstoneJournal"},
        "atlasLandmarks": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/atlasLandmarks"},
        "dungeon": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/dungeon"},
        "partyVehicle": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/partyVehicle"},
        "mapUnits": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/mapUnits"},
        "itemStacks": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/itemStacks"},
        "mapMutations": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/mapMutations"},
        "openDoor": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/openDoor"},
        "basementChestHistory": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/basementChestHistory"},
        "atlasNotes": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/atlasNotes"},
        "atlasFleet": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/atlasFleet"},
        "codexRevelationComplete": {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/properties/codexRevelationComplete"},
        "deedExperiencePaid": {"type": ["array", "null"], "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+(\\.[a-z-]+)+$"}},
        "sharedExperienceRemainder": {"type": "integer", "minimum": 0, "maximum": 5}
      },
      "allOf": [
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/0"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/1"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/2"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/3"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/4"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/5"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/6"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/7"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/8"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/9"},
        {"$ref": "native-save-e2-s26.schema.json#/$defs/snapshot/allOf/10"}
      ]
    }
  }
}
